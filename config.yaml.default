# NGA 举报通知监听配置
# 请把文件名后缀config.yaml.default修改为config.yaml才能正常使用

# ---------------------------------------------------------------------------
# 普通举报监测配置（main.py 使用）
# ---------------------------------------------------------------------------
# NGA 登录 Cookie（从浏览器开发者工具获取）
# 填写完整的 Cookie 字符串，以分号分隔
cookie: ""

# Server酱 3 推送配置
serverchan:
  sendkey: ""

# 免打扰时段（可选，不设置或留空则全天推送）
# 支持多段，跨天时段如 "23:00-07:00"
dnd_hours:
  - "23:00-07:00"
  # - "12:00-13:30"
  
# 限定监测的版面（可选，不设置或留空则监测全部）
# 匹配规则：举报所属版面名包含任一关键字即匹配（如 "原神" 可匹配 "原神>剑斗绮谭"）
monitor_forums:
  - "原神"

# 终端日志开关（默认 true，设为 false 关闭终端输出）
print_log: true

# 抓取间隔（分钟）
interval_minutes: 5

# ---------------------------------------------------------------------------
# 高频举报监测配置（frequent.py 使用，与 main.py 共享本配置文件）
# ---------------------------------------------------------------------------
frequent:
  # 模式1：同一帖子（含回复）在时间窗口内被举报次数超过阈值时推送告警
  mode1:
    # 是否启用模式1
    enabled: true
    # 时间窗口（分钟）
    window_minutes: 30
    # 触发阈值（窗口内被举报次数 >= 此值则推送告警）
    threshold: 3
    # 同一帖子的告警冷却时间（分钟），防止短时间内重复推送同一帖子
    alert_cooldown_minutes: 60
